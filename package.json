{
  "name": "@choi-p/dsh-tenancy",
  "version": "0.1.0-alpha.1",
  "description": "DSH single-instance multi-tenancy: proxy-identity extraction, session-level owner/access ACL over a sidecar store, shadow exact-routes gating session RPCs, and an event-frame filter hook for the client-connection patch.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tenancy",
    "multi-tenant",
    "session",
    "acl"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.sh",
    "examples",
    "patches",
    "scripts",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": false
    },
    "@deepseek-ai/dsh-host-apiproxy": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": false
    }
  }
}
